# Server Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:5173

# Vercel production values
# FRONTEND_URL=https://robo-gig.vercel.app
# ADMIN_FRONTEND_URL=https://robo-gig.vercel.app
# CORS_ALLOWED_ORIGINS=https://robo-gig.vercel.app,https://roboroot.in,https://www.roboroot.in

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/robo_gig?schema=public"

# File storage
AZURE_STORAGE_CONNECTION_STRING="your-azure-storage-connection-string"
AZURE_STORAGE_CONTAINER_NAME="robo-gig-uploads"
AZURE_PRIVATE_STORAGE_CONTAINER_NAME="roboroot-private"
MAX_3D_MODEL_FILE_SIZE_MB=100

# Redis (cache, queues, chat sessions, rate limits)
REDIS_URL="rediss://default:password@your-upstash-host:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Chat / Combined RAG
CHAT_LLM_PROVIDER="nvidia"
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
NVIDIA_API_KEY="your-nvidia-api-key"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_CHAT_MODEL="deepseek-ai/deepseek-v4-pro"
NVIDIA_CHAT_MAX_TOKENS=4096
NVIDIA_CHAT_TEMPERATURE=1
NVIDIA_CHAT_TOP_P=0.95
EMBEDDING_PROVIDER="digitalocean"
DIGITALOCEAN_TOKEN="your-digitalocean-model-access-or-oauth-token"
DIGITALOCEAN_INFERENCE_BASE_URL="https://inference.do-ai.run"
DIGITALOCEAN_EMBEDDING_MODEL="qwen3-embedding-0.6b"
EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY="your-openai-api-key"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
CHAT_SESSION_TTL_SECONDS=3600
CHAT_RATE_LIMIT_PER_MINUTE=20
RAG_CONTEXT_TOKEN_BUDGET=700

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
# GOOGLE_REDIRECT_URI="https://robo-gig.vercel.app/_/backend/api/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:4000/api/auth/github/callback"
# GITHUB_REDIRECT_URI="https://robo-gig.vercel.app/_/backend/api/auth/github/callback"

# Razorpay Payments
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Zoho Payments
# BACKEND_PUBLIC_URL must be publicly reachable by Zoho for hosted-checkout return URLs and webhooks.
BACKEND_PUBLIC_URL="http://localhost:4000"
ZOHO_PAYMENTS_ACCOUNT_ID="your-zoho-payments-account-id"
ZOHO_PAYMENTS_CLIENT_ID="your-zoho-oauth-client-id"
ZOHO_PAYMENTS_CLIENT_SECRET="your-zoho-oauth-client-secret"
ZOHO_PAYMENTS_REFRESH_TOKEN="your-zoho-oauth-refresh-token"
ZOHO_PAYMENTS_SIGNING_KEY="your-zoho-payments-signing-key"
ZOHO_PAYMENTS_WEBHOOK_SIGNING_KEY="your-zoho-webhook-signing-key"
ZOHO_PAYMENTS_API_BASE_URL="https://payments.zoho.in/api/v1"
ZOHO_ACCOUNTS_BASE_URL="https://accounts.zoho.in"
ZOHO_PAYMENTS_HOSTED_CHECKOUT_BASE_URL="https://payments.zoho.in/hostedcheckout"
ZOHO_PAYMENTS_ALLOWED_METHODS="upi,card"
ZOHO_PAYMENTS_SESSION_TTL_SECONDS=900


# OAuth (when implementing Google/GitHub login)
GOOGLE_CLIENT_ID=ssome-google-client-id
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
