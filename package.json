{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.mts",
    "build": "prisma generate && tsc && esbuild dist/server.mjs --bundle --platform=node --format=esm --packages=external --outfile=dist/vercel-server.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "check:deploy": "node --env-file-if-exists=.env scripts/check-deployment.mjs",
    "test:deploy": "node --test tests/deployment.test.mjs",
    "test:email": "node --test tests/email.test.mjs tests/email-workspace.test.mjs",
    "test:projects": "node --import tsx --test tests/projects.test.mjs",
    "test:studio": "node --import tsx --test tests/studio-projects.test.mjs",
    "studio:worker": "node --env-file-if-exists=.env --max-old-space-size=384 --import tsx src/workers/studio-media-worker.ts",
    "studio:worker:prod": "node --env-file-if-exists=.env --max-old-space-size=384 dist/workers/studio-media-worker.js",
    "test:products": "node --import tsx --test tests/product-shopping.test.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "storage:cors": "node --env-file-if-exists=.env --import tsx scripts/configure-r2.mts",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "email:worker": "tsx src/workers/email-worker.ts once",
    "email:worker:watch": "tsx src/workers/email-worker.ts continuous 2",
    "email:worker:prod": "node dist/workers/email-worker.js once",
    "bootstrap": "tsx src/scripts/bootstrap.ts",
    "promote-admin": "tsx src/scripts/promote-admin.ts",
    "verify:3d-model": "tsx src/scripts/verify-3d-model-analysis.ts",
    "test:auth:isolated": "node scripts/test-auth-isolated.mjs",
    "storage:publish": "node --env-file=.env --import tsx scripts/sync-static-assets.mts --apply --verify",
    "test:storage": "node --import tsx --test tests/r2-storage.test.mjs",
    "storage:verify": "node --env-file=.env --import tsx scripts/verify-r2.mts",
    "catalogue:seed-references": "node --env-file=.env --import tsx scripts/seed-albumo-products.mts --apply",
    "test:catalogue": "node --import tsx --test tests/albumo-bulk-import.test.mjs tests/albumo-catalogue.test.mjs tests/catalog-management.test.mjs tests/product-shopping.test.mjs",
    "test:checkout": "node --import tsx --test tests/checkout.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.6",
    "@types/three": "^0.185.4",
    "@types/uuid": "^11.0.0",
    "esbuild": "0.27.1",
    "nodemon": "^3.1.11",
    "prisma": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@azure/storage-blob": "^12.29.1",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@sentry/node": "^10.53.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "razorpay": "^2.9.6",
    "sharp": "0.34.5",
    "three": "^0.185.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  }
}
