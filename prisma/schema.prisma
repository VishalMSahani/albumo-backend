model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  phone           String?   @unique
  pendingPhone    String?   @unique
  phoneVerifiedAt DateTime? @db.Timestamptz(6)
  avatarUrl       String?
  role            UserRole  @default(STUDENT)
  college         String?

  isActive Boolean @default(true)

  emailVerified       Boolean   @default(false)
  emailVerifyToken    String?   @unique
  emailVerifyExpiry   DateTime?
  emailVerifyAttempts Int       @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // relations
  authAccounts       AuthAccount[]
  credential         EmailCredential?
  sessions           Session[]
  emailNotifications EmailNotification[]

  // Project & orders
  createdProjects      Project[]
  studioProjects       StudioProject[]
  orders               Order[]
  addresses            Address[]
  aiGenerationRequests AIGenerationRequest[]

  // Mentor
  mentorProfile   Mentor?
  studentSessions MentorSession[] @relation("StudentSessions")

  // Admin
  adminActionLogs AdminActionLog[]
  fileUploads     FileUpload[]

  // Auth
  passwordResetTokens PasswordResetToken[]

  // Cart
  cart Cart?

  // Wishlist
  wishlistItems WishlistItem[]

  // PCB Quote Requests
  pcbQuoteRequests PcbQuoteRequest[]

  // 3D printing
  threeDPrintFiles  ThreeDPrintFile[]
  threeDPrintOrders ThreeDPrintOrder[]

  // Reviews
  reviews            Review[]
  bulkOrderRequests  BulkOrderRequest[]
  careerApplications CareerApplication[]

  // Legal consent audit trail
  consentRecords ConsentRecord[]

  // Customer support
  supportTickets         SupportTicket[] @relation("SupportTicketRequester")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignee")
}

// Album drafts are separate from the inherited electronics Project domain.
model StudioProject {
  id            String   @id @default(uuid()) @db.Uuid
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title         String   @db.VarChar(120)
  occasion      String   @db.VarChar(24)
  revision      Int      @default(1)
  archivedAt    DateTime? @db.Timestamptz(3)
  trashedAt     DateTime? @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)
  requestId     String   @db.Uuid
  requestHash   String   @db.VarChar(64)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  productId     String?
  configuration Json?
  pageCount     Int?
  minimumPhotos Int?
  recommendedPhotos Int?
  document      Json?
  proof         Json?
  cleanupAttempts Int @default(0)
  cleanupLastAt DateTime? @db.Timestamptz(3)
  cleanupError String? @db.VarChar(80)
  assets        StudioAsset[]
  invites       StudioInvite[]
  reviewStatus  String @default("UNREVIEWED") @db.VarChar(24)
  reviewRevision Int?
  reviewNote    String? @db.VarChar(1000)
  reviewedAt    DateTime? @db.Timestamptz(3)
  activity      StudioActivity[]
  orderLinks    StudioOrderLink[]
  cartItems     StudioCartItem[]

  @@unique([ownerId, requestId])
  @@index([ownerId, archivedAt, createdAt, id])
  @@index([trashedAt, deletedAt])
}

model StudioActivity {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actorId   String
  action    String @db.VarChar(40)
  note      String @db.VarChar(1000)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([projectId, createdAt, id])
}

model StudioOrderLink {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  orderItemId String @unique
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  revision  Int
  snapshot  Json
  printApproval Json?
  actorId   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([projectId])
}

model StudioInvite {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  project     StudioProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tokenHash   String @unique @db.VarChar(64)
  expiresAt   DateTime @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  guests      StudioGuestSession[]
  @@index([projectId])
}

model StudioGuestSession {
  id          String @id @default(uuid()) @db.Uuid
  inviteId    String @db.Uuid
  invite      StudioInvite @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  tokenHash   String @unique @db.VarChar(64)
  displayName String @db.VarChar(80)
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  assets      StudioAsset[]
  @@index([inviteId])
}

model StudioAsset {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  project     StudioProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  guestId     String? @db.Uuid
  guest       StudioGuestSession? @relation(fields: [guestId], references: [id], onDelete: Restrict)
  requestId   String @db.Uuid
  uploaderKey String @db.VarChar(100)
  filename    String @db.VarChar(180)
  mimeType    String @db.VarChar(40)
  byteSize    Int
  status      String @default("UPLOADING") @db.VarChar(20)
  selected    Boolean @default(true)
  stagingKey  String @unique
  originalKey String?
  previewKey  String?
  checksum    String? @db.VarChar(64)
  width       Int?
  height      Int?
  errorCode   String? @db.VarChar(50)
  expiresAt   DateTime @db.Timestamptz(3)
  leaseUntil  DateTime? @db.Timestamptz(3)
  leaseToken  String? @db.Uuid
  attempts    Int @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  @@unique([projectId, uploaderKey, requestId])
  @@index([projectId, createdAt, id])
  @@index([status, leaseUntil])
}

// OAuth / provider accounts (Google, GitHub, etc.)
model AuthAccount {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String // e.g. Google sub, GitHub id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // optional: store tokens if you need them later
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // one providerUserId per provider (prevents duplicates)
  @@unique([provider, providerUserId])
  @@index([userId])
}

// Email + password credentials (1-to-1 with User)
model EmailCredential {
  userId       String @id
  passwordHash String // store only a strong hash (bcrypt/argon2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Optional but recommended for production if you don't want pure stateless JWT.
// You can also drop this and go full JWT if you prefer.
model Session {
  id             String    @id @default(cuid())
  userId         String
  token          String    @unique // random session token / JWT id
  userAgent      String?
  ipAddress      String?
  refreshVersion Int       @default(0)
  rotatedAt      DateTime? @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)

  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// Short-lived challenges; OTPs and registration proofs are only stored as hashes.
model AuthChallenge {
  id          String    @id @default(cuid())
  phone       String
  purpose     String
  userId      String?
  codeHash    String
  proofHash   String?   @unique
  attempts    Int       @default(0)
  expiresAt   DateTime  @db.Timestamptz(6)
  deliveredAt DateTime? @db.Timestamptz(6)
  verifiedAt  DateTime? @db.Timestamptz(6)
  consumedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

// Shared across instances, including serverless deployments without Redis.
model AuthThrottle {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime @db.Timestamptz(6)

  @@index([expiresAt])
}

model EmailNotification {
  text String? @db.Text
  channel String @default("TRANSACTIONAL")
  status String @default("QUEUED")
  fromAddress String?
  replyTo String?
  headers Json?
  dedupeKey String? @unique
  providerMessageId String? @unique
  providerEventAt DateTime? @db.Timestamptz(6)
  deliveredAt DateTime? @db.Timestamptz(6)
  openedAt DateTime? @db.Timestamptz(6)
  clickedAt DateTime? @db.Timestamptz(6)
  lockedUntil DateTime? @db.Timestamptz(6)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
  firstAttemptAt DateTime? @db.Timestamptz(6)
  campaignId String?
  subscriberId String?
  ticketId String?
  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  id        String         @id @default(cuid())
  userId    String?
  email     String
  eventType EmailEventType
  subject   String
  body      String         @db.Text // Use Text for longer email content

  // Additional data (JSON) for email templates
  metadata Json? // Store order details, user details, etc.

  isSent Boolean   @default(false)
  sentAt DateTime? @db.Timestamptz(6)
  error  String?   @db.Text

  retryCount Int @default(0)
  maxRetries Int @default(3)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType, isSent])
  @@index([createdAt])
  @@index([isSent, retryCount])
  @@index([status, nextAttemptAt])
  @@index([campaignId])
}

// ========================================
// PROJECTS & DOCUMENTATION
// ========================================

model Project {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  summary     String? @db.Text
  description String? @db.Text

  // Categorization for better UX
  category ProjectCategory // Main category (IoT, Robotics, Drone, etc.)
  tags     String[] // Additional tags for filtering (e.g., ["beginner-friendly", "arduino", "sensors"])

  projectType ProjectType     @default(FEATURED)
  difficulty  DifficultyLevel @default(BEGINNER)

  // Pricing & Time
  estimatedCostCents        Int? // DIY kit cost in paise/cents
  costEstimateMinCents      Int?
  costEstimateMaxCents      Int?
  estimatedBuildTimeMinutes Int? // Time to complete

  // Pre-Built Option (Admin builds and lists)
  preBuiltAvailable  Boolean  @default(false)
  preBuiltStock      Int      @default(0) // Available pre-built units
  preBuiltPriceCents Int? // Higher price for assembled version
  preBuiltImages     String[] // Photos of actual built units

  // Media
  thumbnailUrl String?
  heroImageUrl String?
  heroVideoUrl String?
  imageUrls    String[] @default([])
  pdfUrls      String[] @default([])
  youtubeUrl   String? // YouTube tutorial video URL
  externalLinks Json?

  // Visibility & Status
  isFeatured    Boolean   @default(false) // Show on homepage
  isPublic      Boolean   @default(true)
  isAIGenerated Boolean   @default(false) // From AI custom project
  publishedAt   DateTime? @db.Timestamptz(6)

  // Learning Info
  learningOutcomes String[] // What student will learn
  prerequisites    String[] // Required knowledge/skills

  // Stats
  viewCount     Int   @default(0)
  buildCount    Int   @default(0) // How many students built this
  averageRating Float @default(0.0)

  // Relations
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  defaultMentorId String?
  defaultMentor   Mentor? @relation("DefaultMentorProjects", fields: [defaultMentorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // relations
  steps             ProjectStep[]
  documentBundle    ProjectDocumentBundle?
  assets            ProjectAsset[]
  projectComponents ProjectComponent[]
  kits              Kit[]
  aiResults         AIGenerationResult[]
  mentorAssignments ProjectMentor[]
  orders            Order[]
  mentorSessions    MentorSession[]
  fileUploads       FileUpload[]
  contentSections   ProjectContentSection[]

  @@index([projectType, isPublic])
  @@index([category])
  @@index([difficulty])
  @@index([isFeatured])
  @@index([isAIGenerated])
  @@index([slug])
  @@index([publishedAt])
  @@index([deletedAt])
}

model ProjectStep {
  id           String  @id @default(cuid())
  projectId    String
  stepNumber   Int
  title        String
  bodyMarkdown String  @db.Text
  pdfUrl       String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([projectId, stepNumber])
  @@index([projectId])
}

model ProjectContentSection {
  id          String   @id @default(cuid())
  projectId   String
  sectionKey  String
  heading     String
  body        String   @db.Text
  sortOrder   Int      @default(0)
  diagramUrl  String?
  code        String?  @db.Text
  repoUrl     String?
  steps       Json?
  faqs        Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([projectId, sectionKey])
  @@index([projectId, sortOrder])
}

model ProjectDocumentBundle {
  id               String  @id @default(cuid())
  projectId        String  @unique
  abstract         String? @db.Text
  problemStatement String? @db.Text
  methodology      String? @db.Text
  applications     Json? // list of strings
  futureScope      Json? // list of strings

  pptUrl           String?
  fullReportPdfUrl String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model ProjectAsset {
  id          String           @id @default(cuid())
  projectId   String
  assetType   ProjectAssetType
  url         String
  description String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([projectId, assetType])
}

model ProjectComponent {
  id          String  @id @default(cuid())
  projectId   String
  componentId String
  quantity    Int     @default(1)
  notes       String?
  isOptional  Boolean @default(false)
  note        String?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([projectId, componentId])
  @@index([componentId])
}

// ========================================
// CATEGORIES & SUBCATEGORIES
// ========================================

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?       @db.Text
  imageUrl      String?
  isActive      Boolean       @default(true)
  subcategories Subcategory[]
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  @@index([isActive])
}

model Subcategory {
  id          String  @id @default(cuid())
  categoryId  String
  name        String
  description String? @db.Text
  imageUrl    String?
  isActive    Boolean @default(true)

  configuration Json?
  products Component[]

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
}

// ========================================
// COMPONENTS & KITS
// ========================================

model Component {
  studioCartItems StudioCartItem[]
  id             String  @id @default(cuid())
  name           String
  slug           String? @unique // SEO-friendly URL identifier e.g. "hc-05-bluetooth-module"
  sku            String? @unique
  description    String? @db.Text
  typicalUseCase String?
  specifications Json    @default("[]")
  countryOfOrigin String?
  warranty        String? @db.Text
  vendorLink     String?
  imageUrl       String?

  subcategoryId String?
  catalogueCategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  configuration Json?

  category         String               @default("Electronics Components")
  subcategory      String               @default("General")
  productType      ComponentProductType @default(ELECTRONICS_COMPONENT)
  brand            String?
  tags             String[]             @default([])
  isBestSeller     Boolean              @default(false)
  isRobomaniacItem Boolean              @default(false)
  isSoftware       Boolean              @default(false)

  unitPriceCents       Int // price per unit (original / compare-at price)
  discountedPriceCents Int? // sale price — null means no active discount
  stockQuantity        Int     @default(0)
  isActive             Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  projectComponents ProjectComponent[]
  kitComponents     KitComponent[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  media             ProductMedia[]
  outgoingRelations ComponentRelation[] @relation("ComponentRelationSource")
  incomingRelations ComponentRelation[] @relation("ComponentRelationTarget")

  @@index([slug])
  @@index([isActive])
  @@index([subcategoryId])
  @@index([category, subcategory])
  @@index([productType])
  @@index([isBestSeller])
  @@index([isRobomaniacItem])
  @@index([sku])
}

model ProductMedia {
  id          String    @id @default(cuid())
  componentId String
  type        MediaType @default(IMAGE)
  url         String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
}

model Kit {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?

  priceCents    Int
  stockQuantity Int     @default(0)
  isActive      Boolean @default(true)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  kitComponents KitComponent[]
  orderItems    OrderItem[]

  @@index([isActive])
  @@index([projectId])
  @@index([slug])
}

model KitComponent {
  id          String @id @default(cuid())
  kitId       String
  componentId String
  quantity    Int    @default(1)

  kit       Kit       @relation(fields: [kitId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([kitId, componentId])
  @@index([componentId])
}

// ========================================
// COMBINED RAG, PAGEINDEX & GRAPH
// ========================================

model RagChunk {
  id         String                       @id @default(cuid())
  sourceType RagChunkSourceType
  sourceId   String
  chunkText  String                       @db.Text
  metadata   Json?
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now()) @db.Timestamptz(6)

  @@index([sourceType, sourceId])
  @@index([createdAt])
}

model Document {
  id         String                @id @default(cuid())
  title      String
  sourceType RagDocumentSourceType
  sourceId   String?
  fileUrl    String?
  metadata   Json?
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @db.Timestamptz(6)

  nodes DocumentNode[]

  @@index([sourceType])
  @@index([sourceId])
  @@index([createdAt])
}

model DocumentNode {
  id         String   @id @default(cuid())
  documentId String
  parentId   String?
  nodeId     String
  title      String
  summary    String   @db.Text
  fullText   String?  @db.Text
  startPage  Int?
  endPage    Int?
  startIndex Int?
  endIndex   Int?
  sortOrder  Int      @default(0)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent   DocumentNode?  @relation("DocumentNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children DocumentNode[] @relation("DocumentNodeTree")

  @@unique([documentId, nodeId])
  @@index([documentId])
  @@index([parentId])
  @@index([documentId, parentId, sortOrder])
}

model ComponentRelation {
  id                String                @id @default(cuid())
  sourceComponentId String
  targetComponentId String
  type              ComponentRelationType
  metadata          Json?
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)

  sourceComponent Component @relation("ComponentRelationSource", fields: [sourceComponentId], references: [id], onDelete: Cascade)
  targetComponent Component @relation("ComponentRelationTarget", fields: [targetComponentId], references: [id], onDelete: Cascade)

  @@unique([sourceComponentId, targetComponentId, type])
  @@index([sourceComponentId, type])
  @@index([targetComponentId, type])
  @@index([type])
}

