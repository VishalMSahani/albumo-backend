  printOrder ThreeDPrintOrder @relation(fields: [printOrderId], references: [id], onDelete: Cascade)

  @@index([printOrderId, createdAt])
}

model SupportTicket {
  id                 String                @id @default(cuid())
  ticketNumber       String                @unique
  userId             String?
  orderId            String?
  assignedToId       String?
  requesterName      String
  requesterEmail     String
  category           SupportTicketCategory
  subject            String
  description        String                @db.Text
  source             String                @default("SUPPORT")
  enquiry            Json?
  priority           SupportTicketPriority @default(MEDIUM)
  status             SupportTicketStatus   @default(OPEN)
  firstResponseDueAt DateTime              @db.Timestamptz(6)
  resolutionDueAt    DateTime              @db.Timestamptz(6)
  firstRespondedAt   DateTime?             @db.Timestamptz(6)
  resolvedAt         DateTime?             @db.Timestamptz(6)
  lastActivityAt     DateTime              @default(now()) @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)

