  boardLayers      Int
  boardSizeX       Float
  boardSizeY       Float
  quantity         Int
  surfaceFinish    String
  copperWeight     String
  gerberFileUrl    String?
  notes            String?        @db.Text
  status           PcbQuoteStatus @default(SUBMITTED)
  quotedPricePaise Int?
  adminNotes       String?        @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
}

// ========================================
// BULK ORDER QUOTE REQUESTS
// ========================================

enum BulkOrderStatus {
  SUBMITTED
  REVIEWING
  QUOTED
  ACCEPTED
  DECLINED
  IN_FULFILLMENT
  COMPLETED
  CANCELLED
}

model BulkOrderRequest {
  id          String          @id @default(cuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String
  companyName String?
  csvFileUrl  String?
  notes       String?         @db.Text
  status      BulkOrderStatus @default(SUBMITTED)
  adminNotes  String?         @db.Text
  reference   String?         @unique
  requestKey  String?         @unique
  accessKeyHash String?
  items       Json            @default("[]")
  postalCode  String?
  deliveryAddress String?     @db.Text
  gstin       String?
  timeline    String?
  consentAt   DateTime?       @db.Timestamptz(6)
  version     Int             @default(0)
  quotes      BulkOrderQuote[]
  messages    BulkOrderMessage[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
}

model BulkOrderQuote {
  id             String   @id @default(cuid())
  requestId      String
  version        Int
  items          Json
  subtotalCents  Int
  taxCents       Int
  shippingCents  Int
  totalCents     Int
  validUntil     DateTime @db.Timestamptz(6)
  leadTime       String
  terms          String   @db.Text
  decision       String?
  decidedAt      DateTime? @db.Timestamptz(6)
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  request        BulkOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@unique([requestId, version])
}

model BulkOrderMessage {
  id        String @id @default(cuid())
  requestId String
  sender    String
  body      String @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  request   BulkOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId, createdAt])
}

// ========================================
// PRODUCT REVIEWS
// ========================================

model Review {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  componentId String?
  component   Component? @relation(fields: [componentId], references: [id], onDelete: Cascade)
  rating      Int
  title       String?
  body        String?    @db.Text
  isVerified  Boolean    @default(false)
  isApproved  Boolean    @default(true)
  imageUrl    String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([userId, componentId])
  @@index([componentId])
  @@index([userId])
  @@index([isApproved])
}

// ========================================
// WISHLIST
// ========================================

model WishlistItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  addedAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([userId, componentId])
  @@index([userId])
}

model MediaLibrary {
  id        String   @id @default(cuid())
  url       String   @unique
  filename  String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

// ========================================
// CAREER APPLICATIONS
// ========================================

enum CareerApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

model CareerApplication {
  id           String                  @id @default(cuid())
  userId       String?
  user         User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String
  portfolioUrl String
  coverLetter  String                  @db.Text
  status       CareerApplicationStatus @default(APPLIED)
  adminNotes   String?                 @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
}

model StagedUpload {
  key String @id
  ownerId String?
  path String
  size Int
  contentType String
  expiresAt DateTime @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([expiresAt])
}

model EmailCampaign {
  id String @id @default(cuid())
  name String
  subject String
  body String @db.Text
  design Json @default("{}")
  status String @default("DRAFT")
  queuedAt DateTime? @db.Timestamptz(6)
  recipientCount Int @default(0)
  createdById String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  emails EmailNotification[]
}

model EmailSuppression {
  email String @id
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model EmailWebhookEvent {
  id String @id
  type String
  payload Json
  processedAt DateTime? @db.Timestamptz(6)
  error String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([processedAt, createdAt])
}

model InboundEmail {
  id String @id @default(cuid())
  providerId String @unique
  fromEmail String
  fromName String @default("")
  recipients Json
  subject String
  text String @db.Text
  messageId String?
  attachments Json @default("[]")
  authenticated Boolean @default(false)
  status String @default("NEW")
  ticketId String?
  receivedAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([status, receivedAt])
}

enum PartnerType {
  TRAVEL_AGENCY
  PHOTOGRAPHER
  WEDDING_PLANNER
  CORPORATE_EVENTS
  REAL_ESTATE
  OTHER
}

enum PartnerInquiryStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  ONBOARDED
  DECLINED
}

model PartnerInquiry {
  id              String               @id @default(cuid())
  partnerType     PartnerType
  status          PartnerInquiryStatus @default(NEW)
  name            String
  email           String
  phone           String
  companyName     String?
  website         String?
  city            String?
  message         String               @db.Text
  expectedVolume  String?
  adminNotes      String?              @db.Text
  contactConsentAt DateTime?           @db.Timestamptz(6)
  directoryConsent Boolean             @default(false)
  directoryConsentAt DateTime?         @db.Timestamptz(6)
  publicName      String?
  publicDescription String?            @db.Text
  publicCity      String?
  publicWebsite   String?
  isPublished     Boolean              @default(false)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  @@index([partnerType])
  @@index([isPublished, partnerType])
  @@index([status])
  @@index([createdAt])
}

model StudioOperationSetting {
  id Int @id @default(1)
  revision Int @default(0)
  policy Json
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  workerHeartbeatAt DateTime? @db.Timestamptz(3)
  workerLastSuccessAt DateTime? @db.Timestamptz(3)
  workerError String? @db.VarChar(80)
}
model StudioPolicyAudit {
  id String @id @default(uuid()) @db.Uuid
  revision Int
  actorId String
  policy Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
