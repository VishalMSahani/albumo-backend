NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Set the permanent domains used by the three Vercel projects.
FRONTEND_URL=https://store.your-domain.example
ADMIN_FRONTEND_URL=https://admin.your-domain.example
BACKEND_PUBLIC_URL=https://api.your-domain.example
CORS_ALLOWED_ORIGINS=https://store.your-domain.example,https://admin.your-domain.example
CSRF_ENABLED=true
# Leave COOKIE_DOMAIN unset so cookies remain owned by the API host.

DATABASE_URL=
REDIS_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Independent secret used to hash both email and WhatsApp OTPs.
AUTH_OTP_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=15d
CRON_SECRET=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=robo-gig-uploads
AZURE_PRIVATE_STORAGE_CONTAINER_NAME=roboroot-private
MAX_3D_MODEL_FILE_SIZE_MB=100

# Preferred transactional email provider. Verify your Albumo sending domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM=noreply@mail.albumo.in
EMAIL_FROM_NAME=Albumo

# Optional legacy fallback used only when RESEND_API_KEY is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Populate only the integrations you use. Never invent gateway webhook secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_REFRESH_TOKEN=
ZOHO_PAYMENTS_SIGNING_KEY=
ZOHO_PAYMENTS_WEBHOOK_SIGNING_KEY=

# WhatsApp Cloud API webhook account setup (message sending is intentionally not configured yet).
# Set the same long random verify token in Meta's callback configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Dashboard -> App settings -> Basic -> App secret. Keep server-side only.
WHATSAPP_APP_SECRET=

# Omit redirect URIs to derive them from BACKEND_PUBLIC_URL.
# Register those same callback URLs in each provider's console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Copy the AI, embedding, and shipping credentials you use from your local setup.


# WhatsApp OTP authentication. Backend only; enable after template approval.
# Sessions are fixed at 15 minutes (access) / 15 days absolute (refresh).
WHATSAPP_OTP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_AUTH_TEMPLATE_NAME=
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=en_US

# All Albumo queue producers and workers must use the same separate prefix.
BULLMQ_PREFIX=albumo

# Albumo Cloudflare R2. Never expose these credentials in frontend variables.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=staticpage
R2_PRIVATE_BUCKET_NAME=albumo-private
R2_PUBLIC_DOMAIN=cdn.albumo.in
# Optional comma-separated website, admin and Studio origins for storage CORS.
R2_ALLOWED_ORIGINS=
FROM_EMAIL=noreply@mail.albumo.in
ADMIN_ALERT_EMAIL=vishal.sahani@albumo.in
# Leave empty to omit Reply-To on automated transactional messages.
EMAIL_REPLY_TO=
SUPPORT_EMAIL=support@albumo.in
ACCOUNT_EMAIL_FROM=account@mail.albumo.in
ACCOUNT_EMAIL_REPLY_TO=support@albumo.in
MARKETING_EMAIL_FROM=update@alert.albumo.in
MARKETING_EMAIL_REPLY_TO=hello@albumo.in
EMAIL_SITE_URL=https://albumo.in
EMAIL_ADMIN_URL=https://admin.albumo.in
EMAIL_API_URL=https://api.albumo.in
EMAIL_INBOUND_DOMAIN=inbox.albumo.in
EMAIL_INBOUND_ENABLED=false
EMAIL_MARKETING_ENABLED=false
EMAIL_SIGNING_SECRET=
RESEND_RECEIVING_API_KEY=
RESEND_WEBHOOK_SECRET=
